# ============================================================================
#  Document AI Bot - environment configuration
#  Copy to `.env`, fill in real values, and NEVER commit the real .env.
#  In production, prefer injecting these via your host's secrets manager.
# ============================================================================

# --- LLM providers (set at least ONE; more = automatic failover) ---
CEREBRAS_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Admin login (REQUIRED to use the Data Ingestion page) ---
# Generate with:  python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# --- Optional: lock the WHOLE app behind a shared access password ---
# Generate with the same script; leave blank to keep the query page open.
APP_ACCESS_PASSWORD_HASH=

# --- Limits (safe defaults; tune as needed) ---
MAX_UPLOAD_MB=25
MAX_KB_TOTAL_MB=200
MAX_QUESTIONS_PER_MIN=20
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
KB_DIR=knowledge_base

# ============================================================================
#  SSO / OIDC (optional but recommended for production)
#  Configure an OIDC app with your provider (Google, Microsoft, Okta, Auth0...)
#  and fill these in. Leave blank to fall back to the password gate.
# ============================================================================
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Generate a random cookie secret, e.g.:  python -c "import secrets;print(secrets.token_hex(32))"
AUTH_COOKIE_SECRET=
# Must match the redirect URI registered with your provider, e.g. https://yourdomain/oauth2callback
AUTH_REDIRECT_URI=
# Provider discovery URL, e.g. Google: https://accounts.google.com/.well-known/openid-configuration
AUTH_SERVER_METADATA_URL=
# Optional: only allow this email domain to sign in (e.g. gnbproperty.com)
AUTH_ALLOWED_DOMAIN=
# Optional: emails that become admins when signed in via SSO (comma-separated)
ADMIN_EMAILS=

# ============================================================================
#  Attachments & escalation to account manager (optional)
# ============================================================================
MAX_ATTACH_MB=20
# Where "not sorted" queries are emailed:
ACCOUNT_MANAGER_EMAIL=
ESCALATION_FROM_EMAIL=
# Email transport — use EITHER SendGrid OR SMTP:
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
